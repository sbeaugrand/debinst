## \copyright CeCILL 2.1 Free Software license
# ---------------------------------------------------------------------------- #
FROM debian:13

RUN export DEBIAN_FRONTEND=noninteractive\
 && dpkg --add-architecture armhf\
 && apt-get -y update\
 && apt-get -y install --no-install-recommends\
    build-essential\
    chrpath\
    cmake\
    debhelper\
    dh-make\
    dpkg-cross\
    fakeroot\
    g++-arm-linux-gnueabihf\
    help2man\
    pkg-config\
    lintian\
    dose-distcheck\
    apt-utils\
    libmpdclient-dev:armhf\
    liblirc-dev:armhf
